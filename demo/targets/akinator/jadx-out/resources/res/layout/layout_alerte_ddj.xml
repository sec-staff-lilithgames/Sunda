<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/custom_alert_rect"
    android:padding="10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/bulle_text_size"
        android:textColor="@color/black_color"
        android:gravity="center"
        android:id="@+id/regleDdj"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:text=""/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">
        <TextView
            android:textSize="@dimen/bulle_text_size"
            android:textColor="@color/black_color"
            android:gravity="center"
            android:id="@+id/regleIndice1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REGLE_INDICE_1"/>
        <ImageView
            android:layout_width="@dimen/gz_icon_size"
            android:layout_height="@dimen/gz_icon_size"
            android:layout_marginLeft="5dp"
            android:src="@drawable/icon_indice_non_dispo"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/bulle_text_size"
        android:textColor="@color/black_color"
        android:gravity="center"
        android:id="@+id/regleIndice2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:text="REGLE_INDICE_2"/>
    <com.digidust.elokence.akinator.graphic.AkinatorSmallButton
        android:id="@+id/okButton"
        android:layout_width="@dimen/gen_small_button_width"
        android:layout_height="@dimen/gen_button_height"
        android:text="NO"/>
</LinearLayout>
