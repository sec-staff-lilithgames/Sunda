<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/cancel_button_margin_top"
    android:layout_marginRight="@dimen/cancel_button_margin_right"
    android:layout_marginBottom="@dimen/cancel_button_margin_top"
    android:layout_alignParentTop="true"
    android:layout_alignParentRight="true">
    <ImageView
        android:id="@+id/homeButtonImage"
        android:layout_width="@dimen/cancel_button_size"
        android:layout_height="@dimen/cancel_button_size"
        android:src="@drawable/button_home"/>
</RelativeLayout>
