<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_expiration"
        android:background="@android:color/transparent"
        android:paddingLeft="@dimen/appconsent_v3_padding_large"
        android:paddingRight="@dimen/appconsent_v3_padding_large"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appconsent_v3_margin_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AppConsentV3Theme.TextView.SmallDescription"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/appconsent_v3_text_size_textview_medium"
        android:gravity="start"
        android:id="@+id/text_vendor_detail_header"
        android:background="@android:color/transparent"
        android:paddingLeft="@dimen/appconsent_v3_padding_large"
        android:paddingTop="@dimen/appconsent_v3_padding_large"
        android:paddingRight="@dimen/appconsent_v3_padding_large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/appconsent_vendor_details_privacy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_expiration"
        style="@style/AppConsentV3Theme.TextButton.Link"/>
</androidx.constraintlayout.widget.ConstraintLayout>
