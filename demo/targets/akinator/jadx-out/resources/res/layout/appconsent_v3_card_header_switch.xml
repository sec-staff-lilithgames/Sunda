<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="end|center_vertical"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:paddingTop="@dimen/appconsent_v3_padding_small"
    android:paddingBottom="@dimen/appconsent_v3_padding_small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/appconsent_v3_margin_xs"
    android:layout_marginBottom="0dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/global_label"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/appconsent_notice_global_switch"
        android:alpha="0.5"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="@dimen/appconsent_v3_margin_xs"
        style="@style/AppConsentV3Theme.TextView.Label.Switch"/>
    <com.sfbx.appconsentv3.ui.view.SwitchView
        android:id="@+id/global_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</androidx.appcompat.widget.LinearLayoutCompat>
