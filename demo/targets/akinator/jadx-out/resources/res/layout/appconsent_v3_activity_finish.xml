<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/int_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/succes_illustration"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/success_container"
        android:background="@drawable/appconsent_v3_background_rounded_dialog"
        android:paddingTop="@dimen/appconsent_v3_padding_large"
        android:paddingBottom="@dimen/appconsent_v3_padding_large"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:orientation="vertical"
            android:id="@+id/scroll_view"
            android:background="@android:color/transparent"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/appconsent_v3_margin_xl"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/button_close"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@android:color/transparent"
                android:paddingLeft="@dimen/appconsent_v3_padding_large"
                android:paddingRight="@dimen/appconsent_v3_padding_large"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/image_success"
                    android:background="@android:color/transparent"
                    android:visibility="gone"
                    android:layout_width="@dimen/appconsent_v3_success_image_size"
                    android:layout_height="@dimen/appconsent_v3_success_image_size"
                    android:layout_marginTop="@dimen/appconsent_v3_margin_xl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_congrats"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/appconsent_v3_margin_xl"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/image_success"
                    style="@style/AppConsentV3Theme.TextView.Title"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:id="@+id/text_subtitle"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appconsent_v3_margin_small"
                    android:textAlignment="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_congrats"
                    style="@style/AppConsentV3Theme.TextView.Description"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="top|center_horizontal"
                    android:id="@+id/text_description"
                    android:background="@android:color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/appconsent_v3_margin_xl"
                    android:textAlignment="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/text_subtitle"
                    style="@style/AppConsentV3Theme.TextView.SmallDescription"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_close"
            android:paddingLeft="@dimen/appconsent_v3_padding_large"
            android:paddingRight="@dimen/appconsent_v3_padding_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/appconsent_v3_margin_small"
            android:minWidth="120dp"
            android:paddingHorizontal="@dimen/appconsent_v3_padding_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/AppConsentV3Theme.Button.Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
