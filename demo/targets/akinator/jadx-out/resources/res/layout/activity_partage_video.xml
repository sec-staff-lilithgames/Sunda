<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainPartageView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/decalage_gauche"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.1"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/decalage_droit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.9"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/decalage_haut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.05"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/decalage_bas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.85"/>
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/decalage_bas"
        app:layout_constraintLeft_toLeftOf="@+id/decalage_gauche"
        app:layout_constraintRight_toLeftOf="@+id/decalage_droit"
        app:layout_constraintTop_toTopOf="@+id/decalage_haut">
        <VideoView
            android:id="@+id/videoPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/layoutButtons"
        android:background="@color/white_color"
        android:padding="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:id="@+id/partageButton"
            android:layout_width="@dimen/iconeBadgeSize"
            android:layout_height="@dimen/iconeBadgeSize"
            android:src="@drawable/partage_video_sharing"
            android:layout_alignParentLeft="true"/>
        <ImageView
            android:id="@+id/deleteButton"
            android:layout_width="@dimen/iconeBadgeSize"
            android:layout_height="@dimen/iconeBadgeSize"
            android:src="@drawable/icon_delete"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/cancelButton"
            android:layout_width="@dimen/iconeBadgeSize"
            android:layout_height="@dimen/iconeBadgeSize"
            android:src="@drawable/partage_video_cancel"
            android:text="cancelButton"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
