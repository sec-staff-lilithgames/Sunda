<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/menu_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/topTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/menu_bandeau_top_height">
        <ImageView
            android:background="@drawable/menu_top_overlay"
            android:layout_width="match_parent"
            android:layout_height="@dimen/menu_bandeau_top_height"/>
        <RelativeLayout
            android:id="@+id/relativeBackButton"
            android:layout_width="@dimen/width_clickable_zone_back_compte"
            android:layout_height="@dimen/heigth_clickable_zone_back_compte">
            <ImageView
                android:id="@+id/backImage"
                android:background="@drawable/button_back"
                android:layout_width="@dimen/menu_button_back_width"
                android:layout_height="@dimen/menu_button_back_heigth"
                android:layout_marginLeft="@dimen/back_button_margin_left"
                android:layout_marginTop="@dimen/back_button_margin_top"
                android:layout_alignParentLeft="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/size_main_text_bandeau_menu"
            android:textColor="@color/color_main_text_bandeau_menu"
            android:id="@+id/modifyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESET PASSWORD"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/size_right_text_bandeau_menu"
            android:textColor="@color/color_main_text_bandeau_menu"
            android:id="@+id/saveText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/margin_rigth_text_bandeau_menu"
            android:text="SAVE"
            android:layout_alignParentRight="true"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayoutCompte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_left_right_edit_text_reset_password"
        android:layout_marginTop="@dimen/margin_top_linear_reset_password"
        android:layout_marginRight="@dimen/margin_left_right_edit_text_reset_password"
        android:layout_below="@+id/topTitle">
        <TextView
            android:textColor="@color/menu_cell_text_color"
            android:id="@+id/textPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOT DE PASSE"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <EditText
                android:textColor="@color/menu_cell_text_color"
                android:textColorHint="@color/menu_cell_text_color"
                android:gravity="center_vertical"
                android:id="@+id/newPasswordEditText"
                android:background="@drawable/background_textbox_soundlike"
                android:paddingLeft="@dimen/padding_left_edit_text_reset_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_edit_text_reset_password"/>
            <ImageView
                android:id="@+id/eyeButton"
                android:background="@drawable/btn_visible_eye"
                android:visibility="invisible"
                android:layout_width="@dimen/width_eye_image_account_page"
                android:layout_height="@dimen/height_eye_image_account_page"
                android:layout_marginRight="@dimen/margin_right_eye_button_image_connection"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
