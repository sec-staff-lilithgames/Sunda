<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:paddingTop="@dimen/appconsent_v3_padding_xl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/appconsentclear_vendor_detail_categories_title"
        android:background="@android:color/transparent"
        android:paddingLeft="@dimen/appconsent_v3_padding_large"
        android:paddingRight="@dimen/appconsent_v3_padding_large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/appconsent_vendor_categories_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AppConsentV3Theme.TextView"/>
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/appconsentclear_vendor_detail_categories_group"
        android:background="@android:color/transparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/appconsent_v3_margin_small"
        android:layout_marginTop="@dimen/appconsent_v3_margin_large"
        android:layout_marginRight="@dimen/appconsent_v3_margin_small"
        android:layout_marginBottom="0dp"
        android:layout_marginHorizontal="@dimen/appconsent_v3_margin_small"
        app:chipSpacingHorizontal="@dimen/appconsent_v3_padding_small"
        app:chipSpacingVertical="@dimen/appconsent_v3_padding_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appconsentclear_vendor_detail_categories_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
