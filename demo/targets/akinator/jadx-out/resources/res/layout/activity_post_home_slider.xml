<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageFond"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/hof_fond"
        android:scaleType="centerCrop"/>
    <FrameLayout
        android:id="@+id/layoutSliderFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/slideractivities_layoutslider_margintop"
        android:layout_above="@+id/layoutBottom"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/image_filtre_enfant"
            android:layout_width="@dimen/gen_button_height"
            android:layout_height="@dimen/gen_button_height"
            android:layout_marginLeft="@dimen/cancel_button_margin_left"
            android:src="@drawable/contenu_sensible_off"
            android:layout_centerVertical="true"/>
        <com.digidust.elokence.akinator.graphic.AkinatorNormalButton
            android:id="@+id/goButton"
            android:layout_width="@dimen/gen_button_width"
            android:layout_height="@dimen/gen_button_height"
            android:text="GO"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/retourButton"
        android:background="@drawable/cancel_button"
        android:layout_width="@dimen/cancel_button_size"
        android:layout_height="@dimen/cancel_button_size"
        android:layout_marginLeft="@dimen/cancel_button_margin_left"
        android:layout_marginTop="@dimen/cancel_button_margin_top"
        android:layout_marginBottom="@dimen/cancel_button_margin_top"
        android:adjustViewBounds="true"/>
    <include
        android:id="@+id/layoutSubjectIconTop"
        layout="@layout/layout_subject_icon_top"/>
    <View
        android:id="@+id/overlayCachePostHome"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
