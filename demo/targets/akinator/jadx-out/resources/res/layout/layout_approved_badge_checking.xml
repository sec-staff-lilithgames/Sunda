<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/badge_rejected_width"
    android:layout_height="@dimen/badge_rejected_heigth">
    <ImageView
        android:id="@+id/approvedImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/badge_validity_check_approved"/>
    <TextView
        android:textSize="25sp"
        android:gravity="center"
        android:id="@+id/approvedText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/badge_rejected_heigth_text"
        android:text="Approved"
        android:layout_centerInParent="true"
        android:textAlignment="center"/>
</RelativeLayout>
