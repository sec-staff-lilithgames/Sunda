<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/appconsent_v3_padding_large"
    android:paddingTop="@dimen/appconsent_v3_padding_large"
    android:paddingRight="@dimen/appconsent_v3_padding_large"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/appconsent_v3_padding_large">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_consentable_detail_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AppConsentV3Theme.TextView.Description"/>
    <ImageView
        android:id="@+id/image_consentable_detail_application_example"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appconsent_v3_margin_small"
        android:src="@drawable/appconsent_clear_ic_drop_down"
        app:layout_constraintEnd_toStartOf="@+id/text_consentable_detail_see_more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_consentable_detail_header"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/appconsent_v3_text_size_textview_large"
        android:gravity="start"
        android:id="@+id/text_consentable_detail_see_more"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/appconsent_v3_margin_xs"
        android:layout_marginRight="@dimen/appconsent_v3_margin_xs"
        android:text="@string/appconsent_application_examples"
        android:layout_marginHorizontal="@dimen/appconsent_v3_margin_xs"
        app:layout_constraintBottom_toBottomOf="@+id/image_consentable_detail_application_example"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image_consentable_detail_application_example"
        app:layout_constraintTop_toTopOf="@+id/image_consentable_detail_application_example"
        style="@style/AppConsentV3Theme.TextButton"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_consentable_detail_additionnal_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appconsent_v3_margin_medium"
        android:layout_marginStart="@dimen/appconsent_v3_margin_small"
        android:layout_marginEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_consentable_detail_see_more"
        style="@style/AppConsentV3Theme.TextView.Description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
