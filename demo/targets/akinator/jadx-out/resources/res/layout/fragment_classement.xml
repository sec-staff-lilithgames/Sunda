<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/classementTitre"
        android:layout_width="@dimen/logoWidth"
        android:layout_height="@dimen/logoHeight"
        android:layout_marginTop="@dimen/marginTopLogo"
        android:src="@drawable/classement_titre"
        android:adjustViewBounds="true"
        android:layout_centerHorizontal="true"/>
    <Button
        android:id="@+id/buttonVote"
        android:background="@drawable/button_vote"
        android:layout_width="@dimen/cancel_button_size"
        android:layout_height="@dimen/cancel_button_size"
        android:layout_marginBottom="3dp"
        android:layout_above="@+id/tabClassement"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/tabClassement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_below="@+id/classementTitre">
        <View
            android:background="@color/black_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/black_color"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/tailleTextClassement"
                android:textColor="@color/black_color"
                android:gravity="center"
                android:id="@+id/buttonClassementVeille"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/gen_micro_button_height"
                android:layout_weight="1"
                android:textAllCaps="false"/>
            <View
                android:background="@color/black_color"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/tailleTextClassement"
                android:textColor="@color/black_color"
                android:gravity="center"
                android:id="@+id/buttonClassementToday"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/gen_micro_button_height"
                android:layout_weight="1"
                android:textAllCaps="false"/>
            <View
                android:background="@color/black_color"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <View
            android:background="@color/black_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/black_color"
        android:gravity="center"
        android:id="@+id/messageErrorHistorique"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_above="@+id/whatIsAkiAward"
        android:layout_below="@+id/tabClassement"/>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_above="@+id/whatIsAkiAward"
        android:layout_below="@+id/tabClassement"
        android:layout_centerVertical="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/zoneClassement"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ScrollView
                    android:scrollbarThumbVertical="@drawable/ak_scrollbar"
                    android:id="@+id/scrollViewTopPlayers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:verticalScrollbarPosition="left">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/zoneTopPlayers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"/>
                </ScrollView>
            </RelativeLayout>
            <View
                android:id="@+id/espace"
                android:layout_width="match_parent"
                android:layout_height="5dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/zoneMe"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/loadingBarClassement"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/zoneTemps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/tailleTextClassement"
                android:textColor="@color/white_color"
                android:id="@+id/textFinDans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"/>
            <TextView
                android:textSize="@dimen/tailleTextClassement"
                android:textColor="@color/white_color"
                android:id="@+id/textTemps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/tailleTextClassement"
            android:textColor="@color/white_color"
            android:id="@+id/textNbParticipant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <Button
        android:id="@+id/whatIsAkiAward"
        android:background="@drawable/award_info"
        android:layout_width="@dimen/share_button_size"
        android:layout_height="@dimen/share_button_size"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"/>
    <Button
        android:id="@+id/buttonClassementHistoriquePodiums"
        android:background="@drawable/award_classement"
        android:layout_width="@dimen/share_button_size"
        android:layout_height="@dimen/share_button_size"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
