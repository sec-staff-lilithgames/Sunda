        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="Name super super long long long long long long"
        android:lines="1"
        android:scrollHorizontally="true"/>
</RelativeLayout>
