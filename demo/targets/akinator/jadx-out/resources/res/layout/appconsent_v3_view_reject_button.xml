<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/layout_reject"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/appconsent_v3_text_size_textview_medium"
        android:textColor="@color/appconsent_v3_dark_grey"
        android:id="@+id/reject_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/appconsent_vendor_details_object"
        android:fontFamily="@font/montserrat_medium"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="@dimen/appconsent_v3_margin_xs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/reject_checkBox"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:gravity="center"
        android:id="@+id/reject_checkBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/appconsent_v3_checkbox"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
