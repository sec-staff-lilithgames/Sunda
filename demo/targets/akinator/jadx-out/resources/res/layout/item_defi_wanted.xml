<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/defiPictureWantedSizeWidth"
        android:layout_height="@dimen/defiPictureWantedSizeHeight">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/topBulle_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.15"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/bottomBulle_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.35"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/leftBulle_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.68"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/leftIndice_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.05"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/rightBulle_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.98"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/rightIndice_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.3"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutPersoPourcent"
            android:background="@drawable/defi_pourcent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomBulle_guide"
            app:layout_constraintLeft_toLeftOf="@+id/leftBulle_guide"
            app:layout_constraintRight_toLeftOf="@+id/rightBulle_guide"
            app:layout_constraintTop_toTopOf="@+id/topBulle_guide">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/leftPc_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.3"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/rightPc_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.9"/>
            <TextView
                android:textSize="@dimen/defi_pc_text_size"
                android:textColor="@color/black_color"
                android:gravity="center"
                android:id="@+id/defiPourcentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20.0%"
                android:maxLines="1"
                android:layout_centerHorizontal="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="@+id/leftPc_guide"
                app:layout_constraintRight_toLeftOf="@+id/rightPc_guide"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/left_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.1"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/right_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.9"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/top_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.1"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/bottom_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.9"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/defi_wanted"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/bottom_guide"
            app:layout_constraintLeft_toLeftOf="@+id/left_guide"
            app:layout_constraintRight_toLeftOf="@+id/right_guide"
            app:layout_constraintTop_toTopOf="@+id/top_guide">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/topText_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.8"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/leftText_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.25"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/rightText_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.75"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/leftPhoto_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.25"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/rightPhoto_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.75"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/topPhoto_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.1"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="horizontal"
                android:id="@+id/bottomPhoto_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.6"/>
            <ImageView
                android:id="@+id/imagePersoWanted"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/bottomPhoto_guide"
                app:layout_constraintLeft_toLeftOf="@+id/leftPhoto_guide"
                app:layout_constraintRight_toLeftOf="@+id/rightPhoto_guide"
                app:layout_constraintTop_toTopOf="@+id/topPhoto_guide"/>
            <TextView
                android:textSize="@dimen/defi_gz_text_size"
                android:textColor="@color/black_color"
                android:gravity="center"
                android:id="@+id/defiGz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0gz"
                android:maxLines="1"
                app:layout_constraintLeft_toLeftOf="@+id/leftText_guide"
                app:layout_constraintRight_toLeftOf="@+id/rightText_guide"
                app:layout_constraintTop_toTopOf="@+id/topText_guide"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/layoutPersoIndice"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/icon_indice_non_dispo"
            app:layout_constraintBottom_toTopOf="@+id/bottomBulle_guide"
            app:layout_constraintLeft_toLeftOf="@+id/leftIndice_guide"
            app:layout_constraintRight_toLeftOf="@+id/rightIndice_guide"
            app:layout_constraintTop_toTopOf="@+id/topBulle_guide"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
