<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <include
        android:id="@+id/genizLayout"
        layout="@layout/layout_geniz"/>
    <include
        android:id="@+id/homeButton"
        layout="@layout/layout_home_button"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/layoutAkinator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/layoutAkinator_margin_top"
        android:layout_marginBottom="@dimen/layoutAkinator_margin_bottom">
        <ImageView
            android:id="@+id/akinatorImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/akinatorTenue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/akinatorChapeau"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="@dimen/cancel_button_size"
        android:layout_marginLeft="@dimen/cancel_button_margin_left"
        android:src="@drawable/virgule"
        android:adjustViewBounds="true"
        android:layout_toRightOf="@+id/backButtonImage"
        android:layout_above="@+id/bulleTextLayout"
        android:alpha="@dimen/alphaBulle"
        android:scaleY="-1"/>
    <View
        android:id="@+id/backButtonImage"
        android:layout_width="@dimen/cancel_button_size"
        android:layout_height="@dimen/cancel_button_size"
        android:layout_marginLeft="@dimen/cancel_button_margin_left"
        android:layout_above="@+id/bulleTextLayout"/>
    <FrameLayout
        android:id="@+id/bulleTextLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bulle_propose_height"
        android:layout_marginBottom="10dp"
        android:layout_above="@+id/continueButtons">
        <ImageView
            android:background="@color/white_color"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="@dimen/alphaBulle"/>
        <TextView
            android:textSize="@dimen/bulle_text_size"
            android:textColor="@color/bulle_text_color"
            android:gravity="center"
            android:id="@+id/bulleText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bulle_propose_height"
            android:text="ON_CONTINUE"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/continueButtons"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gen_button_height"
        android:layout_marginBottom="10dp"
        android:baselineAligned="false"
        android:layout_above="@+id/partageButton">
        <com.digidust.elokence.akinator.graphic.AkinatorSmallButton
            android:id="@+id/yesContinueButton"
            android:layout_width="@dimen/gen_small_button_width"
            android:layout_height="@dimen/gen_button_height"
            android:layout_marginRight="@dimen/proposal_yes_no_buttons_margin_lr"
            android:text="YES"/>
        <com.digidust.elokence.akinator.graphic.AkinatorSmallButton
            android:id="@+id/noContinueButton"
            android:layout_width="@dimen/gen_small_button_width"
            android:layout_height="@dimen/gen_button_height"
            android:layout_marginLeft="@dimen/proposal_yes_no_buttons_margin_lr"
            android:text="NO"/>
    </LinearLayout>
    <View
        android:id="@+id/partageButton"
        android:visibility="invisible"
        android:layout_width="@dimen/share_button_size"
        android:layout_height="@dimen/share_button_size"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
