<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:paddingLeft="@dimen/appconsent_v3_padding_large"
    android:paddingTop="@dimen/appconsent_v3_padding_large"
    android:paddingRight="@dimen/appconsent_v3_padding_large"
    android:paddingBottom="@dimen/appconsent_v3_padding_small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_vendor_lit_header"
        android:background="@android:color/transparent"
        android:paddingTop="@dimen/appconsent_v3_padding_medium"
        android:paddingBottom="@dimen/appconsent_v3_padding_medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/appconsent_vendor_details_label_2"
        android:drawablePadding="@dimen/appconsent_v3_padding_xs"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="@dimen/appconsent_v3_margin_small"
        android:paddingVertical="@dimen/appconsent_v3_padding_medium"
        app:layout_constraintEnd_toStartOf="@+id/reject_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/AppConsentV3Theme.TextView"/>
    <com.sfbx.appconsentv3.ui.view.RejectButtonView
        android:id="@+id/reject_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/text_vendor_lit_header"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text_vendor_lit_header"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/appconsent_v3_text_size_textview_medium"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/vendor_lit_header_url"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/appconsent_v3_margin_medium"
        android:text="@string/appconsent_vendor_legitimate_interest"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/text_vendor_lit_header"
        app:layout_constraintTop_toBottomOf="@+id/text_vendor_lit_header"
        style="@style/AppConsentV3Theme.TextButton.Link"/>
</androidx.constraintlayout.widget.ConstraintLayout>
