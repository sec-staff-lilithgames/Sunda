{
  "id": "aggressive-attach-flake",
  "package": "com.android.purebilibili",
  "mode": "attach",
  "launch": {
    "strategy": "cold",
    "delay_ms": 0
  },
  "driver": {
    "repeat_sessions": 2,
    "timeout_seconds": 35
  },
  "entry": [
    "performNow",
    "perform",
    "performNow"
  ],
  "targets": {
    "classes": [
      "java.lang.Thread",
      "android.app.Application",
      "com.android.purebilibili.app.PureApplication"
    ],
    "enumerate_queries": [
      "java.lang.Thread!*siu",
      "android.app.Application!*si",
      "com.android.purebilibili.app.PureApplication!*si"
    ]
  },
  "operations": [
    {
      "op": "enumerate_methods",
      "query": "java.lang.Thread!*siu"
    },
    {
      "op": "enumerate_methods",
      "query": "android.app.Application!*si"
    },
    {
      "op": "enumerate_methods",
      "query": "com.android.purebilibili.app.PureApplication!*si"
    },
    {
      "op": "hook_method",
      "class_name": "java.lang.Thread",
      "method_name": "getName"
    },
    {
      "op": "hook_method",
      "class_name": "android.app.Application",
      "method_name": "getPackageName"
    },
    {
      "op": "call_static",
      "class_name": "java.lang.Thread",
      "method_name": "currentThread"
    },
    {
      "op": "call_instance",
      "class_name": "java.lang.Thread",
      "method_name": "getName"
    },
    {
      "op": "call_current_application",
      "method_name": "getPackageName"
    },
    {
      "op": "hook_remove_all"
    },
    {
      "op": "hook_method",
      "class_name": "java.lang.Thread",
      "method_name": "getName"
    },
    {
      "op": "hook_method",
      "class_name": "android.app.Application",
      "method_name": "getPackageName"
    }
  ],
  "stress": {
    "rounds": 5,
    "calls_per_round": 200,
    "workers": 2,
    "sleep_ms_between_rounds": 10
  },
  "expect": {
    "crash_worthy_events": [
      "transport-closed",
      "session-detached",
      "frida-crash",
      "pid-lost",
      "pid-drift",
      "script-load-error",
      "bridge-operation-error"
    ]
  }
}
